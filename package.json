{
  "name": "lookforshow",
  "version": "0.0.1",
  "description": "Sharing video-translation service",
  "main": "index.js",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "test": "TS_NODE_TRANSPILE_ONLY=true mocha --require ts-node/register --reporter spec \"common/**/*.test.js\"",
    "test:client": "npm --workspace client test",
    "test:server": "npm --workspace server test",
    "build:client": "npm --workspace client run build",
    "build:server": "npm --workspace server run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "expect": "^29.7.0",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivor06/lookforshow.git"
  },
  "keywords": [
    "typescript",
    "node.js",
    "mongodb",
    "react",
    "redux",
    "video"
  ],
  "author": "Michael Mishkov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ivor06/lookforshow/issues"
  },
  "homepage": "https://github.com/ivor06/lookforshow#readme"
}
